# =============================================================================
# AtmoGraph - NLP & News Intelligence Module (Member 2)
# Copy this file to .env and adjust values. NEVER commit the real .env file.
# All variables use the ATMOGRAPH_ prefix.
# =============================================================================

# --- Application -------------------------------------------------------------
ATMOGRAPH_ENVIRONMENT=development
ATMOGRAPH_DEBUG=false
ATMOGRAPH_HOST=127.0.0.1
ATMOGRAPH_PORT=8000

# Comma-separated origins allowed to call this API (React dev server).
ATMOGRAPH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging -----------------------------------------------------------------
ATMOGRAPH_LOG_LEVEL=INFO
# ATMOGRAPH_LOG_DIR=logs

# --- Data --------------------------------------------------------------------
# ATMOGRAPH_DATA_DIR=data
# ATMOGRAPH_SAMPLE_NEWS_PATH=data/sample_news.json
# ATMOGRAPH_PROCESSED_STORE_PATH=data/processed_articles.json
ATMOGRAPH_ARTICLE_MAX_CHARS=20000

# --- NLP models --------------------------------------------------------------
ATMOGRAPH_SPACY_MODEL=en_core_web_sm
# Transformer classifier is optional; the rule-based baseline is always used.
ATMOGRAPH_ENABLE_TRANSFORMER=false
ATMOGRAPH_TRANSFORMER_MODEL=distilbert-base-uncased
ATMOGRAPH_TRANSFORMER_DEVICE=cpu
ATMOGRAPH_CLASSIFIER_MIN_CONFIDENCE=0.50

# --- News ingestion ----------------------------------------------------------
# Comma-separated RSS feed URLs. Unavailable feeds are logged and skipped.
ATMOGRAPH_RSS_FEEDS=https://feeds.bbci.co.uk/news/business/rss.xml,https://www.supplychaindive.com/feeds/news/
ATMOGRAPH_RSS_TIMEOUT_SECONDS=10
ATMOGRAPH_RSS_MAX_ITEMS_PER_FEED=25
ATMOGRAPH_NEWS_REQUEST_TIMEOUT_SECONDS=15
ATMOGRAPH_NEWS_USER_AGENT=AtmoGraph-NLP/0.1 (+college project)

# --- Member 1 backend (TEMPORARY contract until team agreement) --------------
# Leave graph sync disabled until Member 1 provides the final endpoints.
ATMOGRAPH_GRAPH_SYNC_ENABLED=false
ATMOGRAPH_BACKEND_BASE_URL=http://127.0.0.1:8001
ATMOGRAPH_BACKEND_TIMEOUT_SECONDS=10
ATMOGRAPH_BACKEND_MAX_RETRIES=3
ATMOGRAPH_BACKEND_RETRY_BACKOFF_SECONDS=1.0
# Optional shared secret for the internal API. Keep it only in .env.
# ATMOGRAPH_BACKEND_API_KEY=

# --- Neo4j (only if Member 1 exposes direct access; prefer the backend API) --
# ATMOGRAPH_NEO4J_URI=bolt://127.0.0.1:7687
# ATMOGRAPH_NEO4J_USER=neo4j
# ATMOGRAPH_NEO4J_PASSWORD=
# ATMOGRAPH_NEO4J_DATABASE=neo4j

# --- Limits ------------------------------------------------------------------
ATMOGRAPH_MAX_BATCH_SIZE=50
